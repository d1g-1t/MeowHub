# Django core
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_TIME_ZONE=Europe/Moscow

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DJANGO_DATABASE_URL=postgresql://meowhub:meowhub@db:5432/meowhub

# Redis cache
REDIS_URL=redis://redis:6379/0
CACHE_TTL=120

# DRF API
API_PAGE_SIZE=12

# Security (set True in production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Demo data
DEMO_DATA_ENABLED=True
DJANGO_TEST_USER_USERNAME=meowhub_demo
DJANGO_TEST_USER_EMAIL=demo@meowhub.local
DJANGO_TEST_USER_PASSWORD=meowhub123

# PostgreSQL container
POSTGRES_DB=meowhub
POSTGRES_USER=meowhub
POSTGRES_PASSWORD=meowhub
